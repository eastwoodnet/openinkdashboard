# OpenInk 环境变量配置模板
# 复制为 .env 并按需填充（.env 已被 .gitignore 忽略，绝不入库）

# 手机、第三方应用和非可信网络 API 使用。留空表示不启用 Token 鉴权。
OPENINK_API_TOKEN=

# 默认仅本机访问；局域网部署改为 0.0.0.0，公网应经 HAProxy/Nginx 提供 TLS。
OPENINK_BIND=127.0.0.1
OPENINK_PORT=8080
# 可信 LAN 中的 Studio 管理接口免 Token，外部通知 /api/alert/* 仍需 Token。
# 只取直连来源 IP，不信任 X-Forwarded-For；反代后的外部请求仍需 Token。
OPENINK_STUDIO_TRUSTED_CIDRS=192.168.1.0/24
# 仅允许指定 N516 来源 IP 免密访问 /api/v1/*；多个地址用逗号分隔。
OPENINK_N516_NO_AUTH_IPS=192.168.111.1
# 无 Token 且绑定非回环地址时，必须显式确认当前为可信私有网络。
OPENINK_ALLOW_INSECURE_NO_AUTH=0

# Home Assistant 长期访问令牌（仅启用 HA 插件时需要）
HA_TOKEN=
# 自签名 HA 的私有 CA 文件；不要关闭 TLS 证书验证。
HA_CA_FILE=

# 终端设备密码（可选，优先推荐 SSH 证书免密）
OPENINK_DEVICE_PASSWORD=
