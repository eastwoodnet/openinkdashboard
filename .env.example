# OpenInk 环境变量配置模板
# 复制为 .env 并按需填充（.env 已被 .gitignore 忽略，绝不入库）

# Web Studio 访问密钥 API Token（可选；公网部署或防护 Webhook 时启用）
OPENINK_API_TOKEN=

# Web Studio 绑定地址（默认 0.0.0.0 支持局域网终端访问）
OPENINK_BIND=0.0.0.0

# Home Assistant 长期访问令牌（仅启用 HA 插件时需要）
HA_TOKEN=

# 终端设备密码（可选，优先推荐 SSH 证书免密）
OPENINK_DEVICE_PASSWORD=
