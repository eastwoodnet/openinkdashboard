{
  "city": "Beijing",
  "dashboard": {
    "mode": "carousel",
    "carousel_interval_sec": 60,
    "template": "2_1",
    "slots": {
      "top_left": "calendar",
      "bottom_left": "weather",
      "right": "todo"
    },
    "pages": [
      {
        "id": "page_1",
        "title": "第 1 页 · 主看板",
        "template": "2_1",
        "slots": {
          "top_left": "calendar",
          "bottom_left": "weather",
          "right": "todo"
        }
      },
      {
        "id": "page_2",
        "title": "第 2 页 · 日程倒数",
        "template": "1x2",
        "slots": {
          "left": "agenda",
          "right": "todo"
        }
      }
    ]
  },
  "plugins": {
    "agenda": {
      "enabled": true,
      "ics_urls": [],
      "items": [
        {
          "title": "OpenInk 里程碑发布",
          "date": "+6",
          "time": "全天",
          "is_countdown": true
        },
        {
          "title": "架构评审与墨水屏实机联调",
          "date": "+0",
          "time": "15:00",
          "is_countdown": false
        },
        {
          "title": "外部 ICS 日历同步功能验收",
          "date": "+1",
          "time": "10:30",
          "is_countdown": false
        }
      ]
    },
    "sensors": {
      "enabled": true
    }
  },
  "device": {
    "host": "192.168.111.1",
    "port": 22,
    "user": "root",
    "password_env": "N516_PASSWORD",
    "ssh_alias": "n516",
    "dashboard_dir": "/tmp/dashboard",
    "rotation": 90
  },
  "todos_file": "todos.txt",
  "font_family": "WenQuanYi Micro Hei, Segoe UI Emoji, Maple Mono NF CN, Noto Color Emoji, Segoe UI Symbol, sans-serif",
  "card_shadow": true,
  "shadow_offset": 5,
  "shadow_gray": 0.42,
  "homeassistant": {
    "url": "",
    "token_env": "HA_TOKEN",
    "sensors": [
      {
        "id": "sensor.living_room_temperature",
        "name": "客厅温度"
      },
      {
        "id": "sensor.living_room_humidity",
        "name": "客厅湿度"
      }
    ]
  }
}
